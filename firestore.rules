rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 UID
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '1KzEXKZMoFaYOymYyoI283AR3Y32' ||
        request.auth.uid == 'v4a3ClF3FhWGXsGnZ29wyvQNSCX2'
      );
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // ─── _admin: 관리자만 접근 ──────────────────────────────────────────
    match /_admin/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── stock_picks: 읽기 전체, 쓰기 관리자만 ─────────────────────────
    match /stock_picks/{pickId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // 관리자는 모든 필드 수정 가능, 로그인 유저는 upVotes/downVotes만 수정 가능
      allow update: if isAdmin() ||
        (isLoggedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['upVotes', 'downVotes']));

      // 댓글: 읽기 전체, 쓰기 로그인 유저, 삭제 작성자 또는 관리자
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn();
        allow delete: if isLoggedIn() &&
          (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }

    }

    match /users/{userId}/myComments/{commentId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── announcements: 읽기 전체, 쓰기 관리자만 ──────────────────────
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── market_analyses: 읽기 전체, 쓰기 관리자만 ────────────────────
    match /market_analyses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── users: 본인 데이터만 읽기/쓰기, 관리자 전체 읽기 ────────────
    match /users/{uid} {
      allow read: if isAdmin() || (isLoggedIn() && request.auth.uid == uid);
      allow write: if isLoggedIn() && request.auth.uid == uid;

      match /memos/{pickId} {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /votes/{pickId} {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /blockedUsers/{blockedUid} {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }
    }

    // ─── reports: 로그인 유저 생성, 관리자 읽기/삭제 ──────────────────
    match /reports/{reportId} {
      allow create: if isLoggedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ─── fcm_tokens: 로그인 유저 쓰기, 관리자 읽기 ───────────────────
    match /fcm_tokens/{token} {
      allow create, update: if isLoggedIn();
      allow read, delete: if isAdmin();
    }

    // ─── notification_queue: 관리자만 ─────────────────────────────────
    match /notification_queue/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── night_futures_prices: 읽기 전체, 쓰기 Cloud Function(admin SDK)만 ──
    match /night_futures_prices/{docId} {
      allow read: if true;
      allow write: if false; // Cloud Function admin SDK bypasses rules
    }

    // ─── posts (자유게시판): 읽기 전체, 쓰기 로그인 유저, 삭제 작성자/관리자 ──
    match /posts/{postId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isLoggedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);

      match /likes/{uid} {
        allow read: if true;
        allow write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }
    }

    // ─── trading_journal: 본인만 쓰기, 공개글은 전체 읽기 ──────────────
    match /trading_journal/{journalId} {
      allow read: if resource.data.get('isPublic', false) == true || (isLoggedIn() && resource.data.uid == request.auth.uid);
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isLoggedIn() && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if isLoggedIn() && resource.data.uid == request.auth.uid;

      match /likes/{uid} {
        allow read: if true;
        allow write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }
    }
  }
}
