        offset: _visible ? Offset.zero : const Offset(0, 0.05),
        duration: const Duration(milliseconds: 320),
        curve: Curves.easeOutQuart,
        child: AnimatedScale(
          scale: _visible ? 1 : 0.985,
          duration: const Duration(milliseconds: 320),
          curve: Curves.easeOutQuart,
          child: widget.child,
        ),
      ),
    );
  }
