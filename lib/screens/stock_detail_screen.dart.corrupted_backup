                                _ohlcLabel(
                                  '?',
                                  touched.low,
                                  cs,
                                  color: _kDownColor,
                                ),
                                _ohlcLabel(
                                  '醫?,
                                  touched.close,
                                  cs,
                                  color: touched.close >= touched.open
                                      ? _kUpColor
                                      : _kDownColor,
                                ),
