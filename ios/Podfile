# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
    end
  end

  # Add Run Script phase to fix IOSSIMULATOR-tagged frameworks (App Store error 91169)
  runner_project_path = File.expand_path('../Runner.xcodeproj', __FILE__)
  runner_project = Xcodeproj::Project.open(runner_project_path)
  runner_project.targets.each do |target|
    next unless target.name == 'Runner'
    target.build_phases.delete_if do |phase|
      phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase) &&
        phase.name == 'Fix Simulator Platform Tags'
    end
    phase = target.new_shell_script_build_phase('Fix Simulator Platform Tags')
    phase.shell_script = <<~'SHELL'
      if [ "${PLATFORM_NAME}" = "iphonesimulator" ]; then
        echo "Skipping Fix Simulator Platform Tags on simulator build"
        exit 0
      fi
      find "${CODESIGNING_FOLDER_PATH}/Frameworks" -name "*.framework" -type d | while read framework; do
        binary="${framework}/$(basename ${framework} .framework)"
        if [ ! -f "${binary}" ]; then continue; fi
        platform=$(vtool -show-build "${binary}" 2>/dev/null | awk '/platform/{print $2}')
        if [ "${platform}" = "IOSSIMULATOR" ]; then
          minos="${IPHONEOS_DEPLOYMENT_TARGET:-14.0}"
          vtool -set-build-version ios ${minos} ${minos} -replace -output "${binary}" "${binary}"
          codesign --force --sign "${EXPANDED_CODE_SIGN_IDENTITY}" --preserve-metadata=entitlements "${framework}"
        fi
      done
    SHELL
    phase.run_only_for_deployment_postprocessing = '0'
  end
  runner_project.save
end
