rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin UIDs
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '1KzEXKZMoFaYOymYyoI283AR3Y32' ||
        request.auth.uid == 'v4a3ClF3FhWGXsGnZ29wyvQNSCX2'
      );
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // Admin-only config
    match /_admin/{docId} {
      allow read, write: if isAdmin();
    }

    // Stock picks
    match /stock_picks/{pickId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isLoggedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['upVotes', 'downVotes']));

      // Pick comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn();
        allow delete: if isLoggedIn() &&
          (resource.data.uid == request.auth.uid || isAdmin());
        // 본인 댓글만, content / editedAt 두 필드만 수정 가능.
        allow update: if isLoggedIn() &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content', 'editedAt']);
      }
    }

    match /users/{userId}/myComments/{commentId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /users/{userId}/myPostComments/{commentId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Announcements
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Market analyses
    match /market_analyses/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if isLoggedIn() &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content', 'editedAt']);
      }
    }

    match /market_feature_stocks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Nickname registry
    match /nicknames/{nickname} {
      allow read: if true;
      allow create, update: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isLoggedIn() && (resource == null || resource.data.uid == request.auth.uid);
    }

    // User private data
    match /users/{uid} {
      allow read: if isAdmin() || (isLoggedIn() && request.auth.uid == uid);
      allow write: if isLoggedIn() && request.auth.uid == uid;

      match /memos/{pickId} {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /stock_ai_analyses/{pickId} {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /ai_quota/{dateKey} {
        allow read: if isLoggedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      match /votes/{pickId} {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /blockedUsers/{blockedUid} {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /pick_comment_subscriptions/{pickId} {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /post_comment_subscriptions/{postId} {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /post_author_follows/{targetUid} {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /notification_history/{docId} {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }
    }

    // User public profile
    match /user_public/{uid} {
      allow read: if true;
      allow write: if isLoggedIn() && request.auth.uid == uid;
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isLoggedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // FCM tokens
    match /fcm_tokens/{token} {
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'uid', 'updatedAt'])
        && request.resource.data.token == token
        && (
          (isLoggedIn() && request.resource.data.uid == request.auth.uid) ||
          (!isLoggedIn() && request.resource.data.uid == null)
        );
      allow read, delete: if isAdmin();
    }

    // Notification queue
    match /notification_queue/{docId} {
      allow read, write: if isAdmin();
    }

    // FMKorea index/cache
    match /fmkorea_index/{docId} {
      allow read: if true;
      allow write: if isLoggedIn();
    }

    match /fmkorea_stock_mentions_daily/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /fmkorea_stock_mentions_realtime/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /market_investor_flow/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Night futures prices (KOSPI200 + KOSDAQ150)
    match /night_futures_prices/{docId} {
      allow read: if true;
      allow write: if false; // Cloud Function admin SDK bypasses rules
    }
    match /night_futures_prices_kosdaq/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Free board posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() || (isLoggedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isLoggedIn() && (
        (
          resource.data.uid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'content'])
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );

      match /likes/{uid} {
        allow read: if true;
        allow write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if isLoggedIn() &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content', 'editedAt']);
      }
    }

    // AI 시황 브리프 (누구나 읽기 가능, 쓰기는 Cloud Function만)
    match /ai_briefs/{docId} {
      allow read: if true;
      allow write: if false; // Cloud Function admin SDK bypasses rules
    }

    // Trading journal
    match /trading_journal/{journalId} {
      allow read: if resource.data.get('isPublic', false) == true || (isLoggedIn() && resource.data.uid == request.auth.uid);
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isLoggedIn() && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if isLoggedIn() && resource.data.uid == request.auth.uid;

      match /likes/{uid} {
        allow read: if true;
        allow write: if isLoggedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if isLoggedIn() &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content', 'editedAt']);
      }
    }
  }
}
