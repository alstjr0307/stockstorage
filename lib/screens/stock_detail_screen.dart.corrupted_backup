                            scrollDirection: Axis.horizontal,
                            child: Row(
                              children: [
                                Text(
                                  _formatDate(touched.date),
                                  style: TextStyle(
                                    color: cs.onSurface.withValues(alpha: 0.54),
                                    fontSize: 11,
                                  ),
                                ),
                                const SizedBox(width: 12),
                                _ohlcLabel('??, touched.open, cs),
                                _ohlcLabel(
                                  '怨?,
